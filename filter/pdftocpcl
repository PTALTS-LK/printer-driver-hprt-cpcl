#!/usr/bin/env python3
"""
CUPS 过滤器: PDF → CPCL
适用于: HPRT HM-A300 / HM-T300 移动打印机
协议: CPCL (Comtec Printer Control Language)
用法: pdftocpcl job-id user title copies options [file]

纸张尺寸: 取自作业选项 PageSize / media，或 PPD 的 *DefaultPageSize。
        支持 CUPS 标准自定义尺寸写法，例如
            lp -o PageSize=Custom.80x100mm   (单位可为 mm / cm / in，缺省为点)
            lp -o media=Custom.60x40mm
        指定了纸张尺寸时，PDF 会等比缩放后居中放入「可打印宽 × 标签长」，
        不足部分留白；未指定时按原先的行为（宽度填满）处理。
"""

import sys
import os
import re
import subprocess
import tempfile
import shutil

# ── 打印机参数 ──────────────────────────────────────────────
PRINTER_DPI         = 200     # 打印机分辨率
MAX_PRINT_WIDTH_MM  = 72.0    # 打印头可打印宽度上限 (576 点 @200dpi ≈ 72mm)
PRINTABLE_WIDTH_PX  = int(MAX_PRINT_WIDTH_MM / 25.4 * PRINTER_DPI)  # ≈566 像素
PT_TO_MM            = 25.4 / 72.0
MIN_RENDER_DPI      = 10
MAX_RENDER_DPI      = 1200
# ────────────────────────────────────────────────────────────


def log(msg):
    sys.stderr.write(f"DEBUG: pdftocpcl: {msg}\n")
    sys.stderr.flush()


def error(msg):
    sys.stderr.write(f"ERROR: pdftocpcl: {msg}\n")
    sys.stderr.flush()


def pdf_page_size_pts(pdf_path):
    """返回 PDF 第一页尺寸 (width_pts, height_pts)"""
    try:
        result = subprocess.run(
            ["pdfinfo", pdf_path],
            capture_output=True, text=True, check=True
        )
        for line in result.stdout.splitlines():
            if "Page size" in line:
                # 格式: Page size:  121.88 x 70.86 pts
                parts = line.split()
                return float(parts[2]), float(parts[4])
    except Exception as e:
        log(f"pdfinfo 失败: {e}")
    return None, None


# ── 纸张尺寸解析 ────────────────────────────────────────────
# CUPS 把作业选项放在 argv[5]，形如 "PageSize=Custom.80x100mm Resolution=200dpi"，
# 属性名与 IPP 一致（media 是 PageSize 的别名）。
# 命名尺寸靠 PPD 的 *PageSize 定义解析，自定义尺寸用 CUPS 的
# "Custom.<宽>x<高>[单位]" 写法（单位 mm/cm/in，缺省为点）。

_CUSTOM_SIZE_RE = re.compile(
    r"^custom[._]\s*([0-9]+(?:\.[0-9]+)?)\s*x\s*([0-9]+(?:\.[0-9]+)?)\s*(mm|cm|in|pt)?$",
    re.IGNORECASE,
)
_UNIT_TO_MM = {"mm": 1.0, "cm": 10.0, "in": 25.4, "pt": PT_TO_MM}


def clamp_dpi(dpi):
    return int(max(MIN_RENDER_DPI, min(MAX_RENDER_DPI, round(dpi))))


def parse_options(option_string):
    """解析 CUPS 选项字符串 → {小写属性名: 值}"""
    options = {}
    for token in option_string.split():
        if "=" in token:
            name, value = token.split("=", 1)
            options[name.lower()] = value
    return options


def custom_media_mm(value):
    """解析 Custom.80x100mm / custom_60x40mm → (宽mm, 高mm)；不是自定义尺寸则 None"""
    m = _CUSTOM_SIZE_RE.match(value.strip())
    if not m:
        return None
    factor = _UNIT_TO_MM[(m.group(3) or "pt").lower()]
    return float(m.group(1)) * factor, float(m.group(2)) * factor


def ppd_media_mm(ppd_path, name=None):
    """从 PPD 查询纸张尺寸 → (宽mm, 高mm)；name 为空时取 *DefaultPageSize"""
    if not ppd_path or not os.path.isfile(ppd_path):
        return None
    try:
        with open(ppd_path, "r", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    if not name:
        m = re.search(r"^\*DefaultPageSize:\s*(\S+)", text, re.MULTILINE)
        if not m:
            return None
        name = m.group(1)
    m = re.search(
        r"^\*PageSize\s+" + re.escape(name) + r"(?:/[^:]*)?:\s*"
        r"\"<</PageSize\s*\[\s*([0-9.]+)\s+([0-9.]+)\s*\]",
        text, re.MULTILINE,
    )
    if not m:
        return None
    return float(m.group(1)) * PT_TO_MM, float(m.group(2)) * PT_TO_MM


def resolve_media_mm(options):
    """确定作业的纸张尺寸 (宽mm, 高mm)，无法确定时返回 None"""
    ppd_path = os.environ.get("PPD")
    value = options.get("pagesize") or options.get("media")
    if value:
        size = custom_media_mm(value) or ppd_media_mm(ppd_path, value)
        if size:
            return size
    return ppd_media_mm(ppd_path)


def render_pdf_to_pbm(pdf_path, render_dpi, tmpdir):
    """用 pdftoppm 将 PDF 渲染为单色 PBM 文件列表"""
    out_prefix = os.path.join(tmpdir, "page")
    subprocess.run(
        ["pdftoppm", "-r", str(render_dpi), "-mono", pdf_path, out_prefix],
        check=True,
        stderr=subprocess.DEVNULL
    )
    files = sorted([
        os.path.join(tmpdir, f)
        for f in os.listdir(tmpdir)
        if f.startswith("page") and f.endswith(".pbm")
    ])
    return files


def read_pbm(path):
    """
    读取 P4 (二进制单色) PBM 文件。
    返回 (width, height, rows)
    rows: list of bytearray，每行 ceil(width/8) 字节，1=黑 0=白
    """
    with open(path, "rb") as f:
        raw = f.read()

    # 解析头部
    pos = 0
    tokens = []
    while len(tokens) < 3:
        # 跳过空白
        while pos < len(raw) and raw[pos:pos+1] in (b' ', b'\t', b'\r', b'\n'):
            pos += 1
        if pos >= len(raw):
            break
        # 跳过注释
        if raw[pos:pos+1] == b'#':
            while pos < len(raw) and raw[pos:pos+1] != b'\n':
                pos += 1
            continue
        # 读取 token
        start = pos
        while pos < len(raw) and raw[pos:pos+1] not in (b' ', b'\t', b'\r', b'\n'):
            pos += 1
        tokens.append(raw[start:pos].decode('ascii'))

    assert tokens[0] == 'P4', f"不是 P4 格式: {tokens[0]}"
    width  = int(tokens[1])
    height = int(tokens[2])

    # 跳过头部最后一个空白字符
    if pos < len(raw) and raw[pos:pos+1] in (b' ', b'\t', b'\r', b'\n'):
        pos += 1

    row_bytes = (width + 7) // 8
    rows = [bytearray(raw[pos + r * row_bytes : pos + (r + 1) * row_bytes])
            for r in range(height)]
    return width, height, rows


def place_bitmap(rows, dst_width, dst_height, x_offset, y_offset):
    """
    把位图放到 dst_width × dst_height 的画布上（不裁剪、不变形，不足处留白）。
    返回 dst_height 行、每行 ceil(dst_width/8) 字节的位图。
    超出画布的部分会被裁掉。
    """
    dst_bytes = (dst_width + 7) // 8
    total_bits = dst_bytes * 8
    # 每行用的是大端位串，第 0 位在最左边；画布右侧不足一字节的补位必须保持为 0
    mask = ((1 << dst_width) - 1) << (total_bits - dst_width)
    canvas = [0] * dst_height
    for y, row in enumerate(rows):
        dst_y = y_offset + y
        if not 0 <= dst_y < dst_height:
            continue
        value = int.from_bytes(bytes(row), "big")
        shift = total_bits - len(row) * 8 - x_offset
        value = value << shift if shift >= 0 else value >> -shift
        canvas[dst_y] |= value & mask
    return [bytearray(v.to_bytes(dst_bytes, "big")) for v in canvas]


def build_cpcl(width_px, rows):
    """
    构建 CPCL EG (EXPANDED-GRAPHICS) 打印命令。

    CPCL 格式:
      ! 0 {h-dpi} {v-dpi} {height} {qty}\\r\\n
      EG {byte-width} {dot-height} {x} {y} {hex-data}\\r\\n
      FORM\\r\\n
      PRINT\\r\\n
    """
    height_px = len(rows)
    w_bytes = (width_px + 7) // 8

    # 构建 hex 数据（每字节→2个十六进制字符）
    hex_parts = []
    for row in rows:
        row_data = bytes(row[:w_bytes]).ljust(w_bytes, b'\x00')
        hex_parts.append(row_data.hex().upper())
    hex_data = "".join(hex_parts)

    lines = [
        f"! 0 {PRINTER_DPI} {PRINTER_DPI} {height_px} 1",
        f"EG {w_bytes} {height_px} 0 0 {hex_data}",
        "FORM",
        "PRINT",
    ]
    return "\r\n".join(lines) + "\r\n"


def main():
    # CUPS 过滤器参数: job-id user title copies options [file]
    if len(sys.argv) < 6:
        sys.stderr.write(
            "Usage: pdftocpcl job-id user title copies options [file]\n"
        )
        sys.exit(1)

    options = parse_options(sys.argv[5])
    log(f"任务选项: {sys.argv[5]}")

    tmpdir = tempfile.mkdtemp(prefix="pdftocpcl_")
    try:
        # 获取输入文件
        if len(sys.argv) == 7:
            input_pdf = sys.argv[6]
        else:
            # 从 stdin 读取到临时文件
            input_pdf = os.path.join(tmpdir, "input.pdf")
            with open(input_pdf, "wb") as f:
                f.write(sys.stdin.buffer.read())

        # 纸张尺寸（作业选项或 PPD）与 PDF 尺寸
        media = resolve_media_mm(options)
        w_pts, h_pts = pdf_page_size_pts(input_pdf)
        pdf_w_mm = pdf_h_mm = None
        if w_pts and h_pts:
            pdf_w_mm, pdf_h_mm = w_pts * PT_TO_MM, h_pts * PT_TO_MM
            log(f"PDF 尺寸: {pdf_w_mm:.1f}mm x {pdf_h_mm:.1f}mm")

        # 计算渲染 DPI 与输出画布
        canvas = None
        if media and pdf_w_mm:
            # 指定了纸张：等比缩放到刚好放进「可打印宽 × 标签长」
            # 可打印宽 = min(纸宽, 打印头宽度上限)，窄纸可 1:1 输出
            printable_mm = max(1.0, min(media[0], MAX_PRINT_WIDTH_MM))
            scale = min(printable_mm / pdf_w_mm, media[1] / pdf_h_mm)
            render_dpi = clamp_dpi(PRINTER_DPI * scale)
            canvas = (
                max(1, round(printable_mm / 25.4 * PRINTER_DPI)),
                max(1, round(media[1] / 25.4 * PRINTER_DPI)),
            )
            log(f"纸张尺寸: {media[0]:.1f}mm x {media[1]:.1f}mm  "
                f"可打印宽: {printable_mm:.1f}mm  画布: {canvas[0]}x{canvas[1]}px")
        elif pdf_w_mm:
            # 未指定纸张：保持原行为，按宽度铺满打印宽度
            render_dpi = clamp_dpi(PRINTER_DPI * (MAX_PRINT_WIDTH_MM / pdf_w_mm))
            log(f"未指定纸张尺寸，按宽度铺满 {MAX_PRINT_WIDTH_MM:.0f}mm")
        else:
            error("无法获取 PDF 尺寸，使用默认 DPI")
            render_dpi = PRINTER_DPI
        log(f"渲染 DPI: {render_dpi} (缩放比 {render_dpi / PRINTER_DPI:.2f}x)")

        # 渲染 PDF 为位图
        pbm_files = render_pdf_to_pbm(input_pdf, render_dpi, tmpdir)
        if not pbm_files:
            error("未生成任何页面")
            sys.exit(1)

        log(f"共 {len(pbm_files)} 页")

        # 逐页转换并输出 CPCL
        for i, pbm in enumerate(pbm_files):
            width, height, rows = read_pbm(pbm)
            if canvas:
                out_w, out_h = canvas
                rows = place_bitmap(
                    rows, out_w, out_h,
                    max(0, (out_w - width) // 2),
                    max(0, (out_h - height) // 2),
                )
            else:
                out_w, out_h = min(width, PRINTABLE_WIDTH_PX), height
            log(f"第 {i+1} 页: {out_w}x{out_h}px ({out_w/PRINTER_DPI*25.4:.1f}x{out_h/PRINTER_DPI*25.4:.1f}mm)")
            cpcl = build_cpcl(out_w, rows)
            sys.stdout.buffer.write(cpcl.encode('ascii'))

        log("转换完成")
        sys.exit(0)

    except subprocess.CalledProcessError as e:
        error(f"外部命令失败: {e}")
        sys.exit(1)
    except Exception as e:
        error(f"未预期错误: {e}")
        import traceback
        traceback.print_exc(file=sys.stderr)
        sys.exit(1)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


if __name__ == "__main__":
    main()
